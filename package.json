{
  "name": "ttrpg-forge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "scripts": {
    "dev": "pnpm --filter @forge/web dev",
    "build": "pnpm --filter @forge/web build",
    "preview": "pnpm --filter @forge/web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "e2e": "pnpm --filter @forge/web e2e",
    "check:phb": "node tools/deploy/check-phb.mjs",
    "build:pages": "pnpm check:phb && pnpm --filter @forge/web exec vite build --mode pages",
    "e2e:pages": "pnpm --filter @forge/web exec playwright test --config playwright.pages.config.ts",
    "validate:pack": "node tools/pack/validate.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "@types/node": "^22.0.0"
  }
}
